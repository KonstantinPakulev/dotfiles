{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "webfetch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "~/Documents/**": "allow",
      "~/Desktop/**": "allow",
      "~/Downloads/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cut *": "allow",
      "sort *": "allow",
      "wc *": "allow",
      "touch *": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git -C * status*": "allow",
      "git -C * log*": "allow",
      "git -C * diff*": "allow",
      "git -C * remote": "allow",
      "git -C * remote -v*": "allow",
      "git submodule": "allow",
      "git submodule status": "allow",
      "git submodule status *": "allow",
      "git submodule summary *": "allow",
      "git check-ignore *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker inspect *": "allow",
      "docker logs *": "allow",
      "docker stats": "allow",
      "docker stats *": "allow",
      "docker top *": "allow",
      "docker port *": "allow",
      "docker diff *": "allow",
      "docker container ls*": "allow",
      "docker container inspect *": "allow",
      "docker container logs *": "allow",
      "docker container top *": "allow",
      "docker container port *": "allow",
      "docker container diff *": "allow",
      "docker images": "allow",
      "docker images *": "allow",
      "docker image ls*": "allow",
      "docker image inspect *": "allow",
      "docker image history *": "allow",
      "docker version*": "allow",
      "docker info": "allow",
      "docker compose ps": "allow",
      "docker compose ps *": "allow",
      "docker compose logs": "allow",
      "docker compose logs *": "allow",
      "docker compose config": "allow",
      "docker compose config *": "allow",
      "docker compose images": "allow",
      "docker compose images *": "allow",
      "docker compose top": "allow",
      "docker compose top *": "allow",
      "find *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "whoami *": "allow",
      "hostname": "allow",
      "hostname *": "allow",
      "date": "allow",
      "which *": "allow",
      "command *": "allow",
      "type *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "tree *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "shasum *": "allow",
      "sha256sum *": "allow",
      "md5 *": "allow",
      "ps *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "pip show *": "allow",
      "jupyter nbconvert *": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "lsp": true
}
