{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Documents/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Desktop/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Downloads/**", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git log", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git -C * status*", "effect": "allow" },
    { "action": "shell", "resource": "git -C * log*", "effect": "allow" },
    { "action": "shell", "resource": "git -C * diff*", "effect": "allow" },
    { "action": "shell", "resource": "git -C * remote", "effect": "allow" },
    { "action": "shell", "resource": "git -C * remote -v*", "effect": "allow" },
    { "action": "shell", "resource": "git submodule", "effect": "allow" },
    { "action": "shell", "resource": "git submodule status", "effect": "allow" },
    { "action": "shell", "resource": "git submodule status *", "effect": "allow" },
    { "action": "shell", "resource": "git submodule summary *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker stats", "effect": "allow" },
    { "action": "shell", "resource": "docker stats *", "effect": "allow" },
    { "action": "shell", "resource": "docker top *", "effect": "allow" },
    { "action": "shell", "resource": "docker port *", "effect": "allow" },
    { "action": "shell", "resource": "docker diff *", "effect": "allow" },
    { "action": "shell", "resource": "docker container ls*", "effect": "allow" },
    { "action": "shell", "resource": "docker container inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker container logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker container top *", "effect": "allow" },
    { "action": "shell", "resource": "docker container port *", "effect": "allow" },
    { "action": "shell", "resource": "docker container diff *", "effect": "allow" },
    { "action": "shell", "resource": "docker images", "effect": "allow" },
    { "action": "shell", "resource": "docker images *", "effect": "allow" },
    { "action": "shell", "resource": "docker image ls*", "effect": "allow" },
    { "action": "shell", "resource": "docker image inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker image history *", "effect": "allow" },
    { "action": "shell", "resource": "docker version*", "effect": "allow" },
    { "action": "shell", "resource": "docker info", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose logs", "effect": "allow" },
    { "action": "shell", "resource": "docker compose logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose config", "effect": "allow" },
    { "action": "shell", "resource": "docker compose config *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose images", "effect": "allow" },
    { "action": "shell", "resource": "docker compose images *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose top", "effect": "allow" },
    { "action": "shell", "resource": "docker compose top *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },
    { "action": "shell", "resource": "whoami *", "effect": "allow" },
    { "action": "shell", "resource": "hostname", "effect": "allow" },
    { "action": "shell", "resource": "hostname *", "effect": "allow" },
    { "action": "shell", "resource": "date", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "command *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "cmp *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "shasum *", "effect": "allow" },
    { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
    { "action": "shell", "resource": "md5 *", "effect": "allow" },
    { "action": "shell", "resource": "ps *", "effect": "allow" },
    { "action": "shell", "resource": "pgrep *", "effect": "allow" },
    { "action": "shell", "resource": "uname", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "pip show *", "effect": "allow" },
    { "action": "shell", "resource": "jupyter nbconvert *", "effect": "allow" },
    { "action": "shell", "resource": "curl *127.0.0.1:*", "effect": "allow" },
    { "action": "shell", "resource": "curl *localhost:*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue *", "effect": "allow" },
    { "action": "shell", "resource": "gh search code *", "effect": "allow" },
    { "action": "shell", "resource": "python scripts/claude/*", "effect": "allow" },
    { "action": "shell", "resource": "python scripts/gluefactory/compare_pipeline_eval.py *", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "read", "resource": "*.env.secrets", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/id_*", "effect": "deny" },
    { "action": "shell", "resource": "*.env.secrets*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" }
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "lsp": true
}
