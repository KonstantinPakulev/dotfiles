{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "webfetch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cut *": "allow",
      "sort *": "allow",
      "wc *": "allow",
      "touch *": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "lsp": true
}
